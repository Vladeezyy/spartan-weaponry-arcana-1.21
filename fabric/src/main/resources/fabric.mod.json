{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}\\nUnofficial port of Spartan Weaponry: Arcana beta-1.0.3 (ObliviousSpartan, GPL-3.0) to Minecraft ${minecraft_version} / Fabric.",
  "authors": ["${mod_authors}"],
  "contributors": ["Vladeezyy (port)"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/spartan-weaponry-arcana",
    "sources": "https://github.com/Vladeezyy/spartan-weaponry-arcana-1.21",
    "issues": "https://github.com/Vladeezyy/spartan-weaponry-arcana-1.21/issues"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "spartanweaponry": ["com.oblivioussp.spartanweaponryarcana.fabric.SpartanWeaponryArcanaFabric"],
    "client": ["com.oblivioussp.spartanweaponryarcana.fabric.SpartanWeaponryArcanaFabricClient"]
  },
  "mixins": ["spartanweaponryarcana.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "spartanweaponry": ">=3.2.1.2",
    "java": ">=${java_version}"
  },
  "suggests": {
    "botania": "*"
  }
}
